<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TasteVinhKhanh.MauiApp.ViewModels"
             xmlns:data="clr-namespace:TasteVinhKhanh.MauiApp.Data"
             xmlns:conv="clr-namespace:TasteVinhKhanh.MauiApp.Converters"
             x:Class="TasteVinhKhanh.MauiApp.Views.PoiDetailPage"
             x:DataType="vm:PoiDetailViewModel"
             Title="{Binding Poi.Name}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0D0D">

    <ContentPage.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- HEADER -->
        <Grid Grid.Row="0" Padding="20,52,20,16" BackgroundColor="#0D0D0D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Text="←" FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="#FF6B35"
                    VerticalOptions="Center"
                    Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="{Binding Poi.Name}"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="0,0,40,0"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="16" Spacing="16">

                <!-- ẢNH -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        HeightRequest="220"
                        IsVisible="{Binding Poi.ImageUrl, Converter={StaticResource NullToBoolConverter}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A1500" Offset="0"/>
                            <GradientStop Color="#1A0D00" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="{Binding Poi.ImageUrl}" Aspect="AspectFill"/>
                </Border>

                <!-- TÊN + MÔ TẢ -->
                <StackLayout Spacing="8">
                    <Label Text="{Binding Poi.Name}"
                           FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    <Label Text="{Binding Poi.ShortDescription}"
                           FontSize="14" TextColor="#888888"
                           LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- THÔNG TIN -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16"
                        Stroke="#252525" Padding="16">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*">
                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="📍" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Địa điểm" FontSize="11" TextColor="#666666" HorizontalOptions="Center"/>
                        </StackLayout>
                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="🎵" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Thuyết minh" FontSize="11" TextColor="#666666" HorizontalOptions="Center"/>
                        </StackLayout>
                        <StackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="⭐" FontSize="22" HorizontalOptions="Center"/>
                            <Label Text="Yêu thích" FontSize="11" TextColor="#666666" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Grid>
                </Border>

                <!-- NÚT PHÁT -->
                <Border StrokeShape="RoundRectangle 16" Stroke="Transparent">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6B35" Offset="0"/>
                            <GradientStop Color="#FF4500" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button Text="🔊  Nghe thuyết minh"
                            Command="{Binding PlayNarrationCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="0" HeightRequest="54"/>
                </Border>

                <!-- NÚT XEM BẢN ĐỒ -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#FF6B3540" Padding="1"
                        IsVisible="{Binding Poi.MapUrl, Converter={StaticResource NullToBoolConverter}}">
                    <Button Text="🗺️  Xem trên Google Maps"
                            Command="{Binding OpenMapCommand}"
                            BackgroundColor="#1A1A1A"
                            TextColor="#FF6B35"
                            FontSize="15" FontAttributes="Bold"
                            CornerRadius="15" HeightRequest="50"/>
                </Border>

                <!-- NGÔN NGỮ CÓ SẴN -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16"
                        Stroke="#252525" Padding="16">
                    <StackLayout Spacing="10">
                        <Label Text="Ngôn ngữ thuyết minh" FontAttributes="Bold"
                               FontSize="14" TextColor="#FFFFFF"/>
                        <FlexLayout BindableLayout.ItemsSource="{Binding Scripts}"
                                    Wrap="Wrap" Direction="Row" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="data:LocalAudioScript">
                                    <Border BackgroundColor="#FF6B3520"
                                            StrokeShape="RoundRectangle 20"
                                            Stroke="Transparent"
                                            Padding="12,6" Margin="4,2">
                                        <Label Text="{Binding LanguageCode, StringFormat='{}{0}'}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="#FF6B35"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </StackLayout>
                </Border>

                <!-- VERSION SPACER -->
                <BoxView HeightRequest="40" Color="Transparent"/>

            </StackLayout>
        </ScrollView>

        <!-- BOTTOM NAV -->
        <Border Grid.Row="2" Stroke="#1E1E1E" StrokeShape="RoundRectangle 0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111111" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*,*" Padding="0,10,0,24">
                <StackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="⊞" FontSize="24" TextColor="#444444" HorizontalOptions="Center"/>
                    <Label Text="Home" FontSize="10" TextColor="#444444" HorizontalOptions="Center"/>
                </StackLayout>
                <StackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="🗺" FontSize="24" TextColor="#444444" HorizontalOptions="Center"/>
                    <Label Text="Map" FontSize="10" TextColor="#444444" HorizontalOptions="Center"/>
                </StackLayout>
                <Grid Grid.Column="2" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 30" Stroke="Transparent"
                            WidthRequest="58" HeightRequest="58"
                            HorizontalOptions="Center" Margin="0,-28,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#FF4500" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="🎵" FontSize="24"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
                <StackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Label Text="⚙" FontSize="24" TextColor="#444444" HorizontalOptions="Center"/>
                    <Label Text="Settings" FontSize="10" TextColor="#444444" HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TasteVinhKhanh.MauiApp.ViewModels"
             xmlns:data="clr-namespace:TasteVinhKhanh.MauiApp.Data"
             xmlns:conv="clr-namespace:TasteVinhKhanh.MauiApp.Converters"
             x:Class="TasteVinhKhanh.MauiApp.Views.PoiDetailPage"
             x:DataType="vm:PoiDetailViewModel"
             x:Name="RootPage"
             Title="{Binding Poi.Name}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A0A00">

    <ContentPage.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <conv:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
        <conv:ImageUrlConverter x:Key="ImageUrlConverter"/>
        <conv:TabBgConverter x:Key="TabBgConverter"/>
        <conv:TabTextConverter x:Key="TabTextConverter"/>
        <conv:MultiLangBgConverter x:Key="MultiLangBgConverter"/>
        <conv:MultiLangTextColorConverter x:Key="MultiLangTextColorConverter"/>
        <conv:MultiLangBadgeVisibleConverter x:Key="MultiLangBadgeVisibleConverter"/>
        <conv:MultiLangStrokeConverter x:Key="MultiLangStrokeConverter"/>
        <conv:FavoriteHeartConverter x:Key="FavoriteHeartConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- HEADER: giảm top padding để không có khoảng đen trên -->
        <Grid Grid.Row="0" Padding="16,16,16,12" BackgroundColor="#1A0A00">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Text="←" FontSize="20"
                    BackgroundColor="Transparent" TextColor="#FF6B35"
                    VerticalOptions="Center" Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="{Binding Poi.Name}"
                   FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF"
                   VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,40,0"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout Padding="16" Spacing="16">

                <!-- CAROUSEL ẢNH GALLERY -->
                <Grid HeightRequest="220"
                      IsVisible="{Binding ImagesCount, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ẢNH HIỆN TẠI -->
                    <Border Grid.Row="0" StrokeShape="RoundRectangle 20" Stroke="Transparent">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A1500" Offset="0"/>
                                <GradientStop Color="#1A0D00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="{Binding CurrentImage.ImageUrl, Converter={StaticResource ImageUrlConverter}}"
                               Aspect="AspectFill"/>
                    </Border>

                    <!-- NÚT ← -->
                    <Button Grid.Row="0"
                            Text="◀" FontSize="22" FontAttributes="Bold"
                            BackgroundColor="#80000000" TextColor="White"
                            WidthRequest="44" HeightRequest="44" CornerRadius="22"
                            HorizontalOptions="Start" VerticalOptions="Center"
                            Margin="8,0,0,0" Padding="0"
                            Command="{Binding PreviousImageCommand}"/>

                    <!-- NÚT → -->
                    <Button Grid.Row="0"
                            Text="▶" FontSize="22" FontAttributes="Bold"
                            BackgroundColor="#80000000" TextColor="White"
                            WidthRequest="44" HeightRequest="44" CornerRadius="22"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Margin="0,0,8,0" Padding="0"
                            Command="{Binding NextImageCommand}"/>

                    <!-- DOT INDICATOR -->
                    <StackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,12">
                        <CollectionView ItemsSource="{Binding Dots}" HeightRequest="10" WidthRequest="0">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImageDotItem">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                             BackgroundColor="{Binding DotColor}"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Grid>

                <!-- ẢNH COVER (khi không có gallery) -->
                <Border StrokeShape="RoundRectangle 20" Stroke="Transparent"
                        HeightRequest="220"
                        IsVisible="{Binding ImagesCount, Converter={StaticResource InverseCountToVisibilityConverter}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A1500" Offset="0"/>
                            <GradientStop Color="#1A0D00" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="{Binding Poi.ImageUrl, Converter={StaticResource ImageUrlConverter}}" Aspect="AspectFill"/>
                </Border>

                <!-- TÊN + MÔ TẢ -->
                <StackLayout Spacing="8">
                    <Label Text="{Binding Poi.Name}" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    <Label Text="{Binding Poi.ShortDescription}" FontSize="14" TextColor="#888888" LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- ĐIỀU HƯỚNG TOUR -->
                <Border BackgroundColor="#1A1A1A"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#252525"
                        Padding="12"
                        IsVisible="{Binding IsTourMode}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Button Grid.Column="0"
                                Text="◀ Trước"
                                Command="{Binding GoToPreviousTourStopCommand}"
                                IsEnabled="{Binding HasPreviousTourStop}"
                                BackgroundColor="#252525"
                                TextColor="#FF6B35"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="40"/>
                        <Label Grid.Column="1"
                               Text="{Binding TourProgressText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="#CCCCCC"
                               FontSize="13"
                               FontAttributes="Bold"/>
                        <Button Grid.Column="2"
                                Text="Tiếp ▶"
                                Command="{Binding GoToNextTourStopCommand}"
                                IsEnabled="{Binding HasNextTourStop}"
                                BackgroundColor="#252525"
                                TextColor="#FF6B35"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="40"/>
                    </Grid>
                </Border>

                <!-- TABS CÓ THỂ CLICK -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16" Stroke="#252525" Padding="16">
                    <Grid ColumnDefinitions="*,*,*">

                        <!-- Địa điểm -->
                        <StackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="8">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTabLocationTapped"/>
                            </StackLayout.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    Padding="10" BackgroundColor="{Binding IsTabLocation, Converter={StaticResource TabBgConverter}}">
                                <Label Text="&#x1F4CD;" FontSize="22" HorizontalOptions="Center"/>
                            </Border>
                            <Label Text="{Binding TLocation}" FontSize="11"
                                   TextColor="{Binding IsTabLocation, Converter={StaticResource TabTextConverter}}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>

                        <!-- Thuyết minh -->
                        <StackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="8">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTabNarrationTapped"/>
                            </StackLayout.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    Padding="10"
                                    BackgroundColor="{Binding IsTabNarration, Converter={StaticResource TabBgConverter}}">
                                <Label Text="&#x1F3B5;" FontSize="22" HorizontalOptions="Center"
                                       TextColor="{Binding IsTabNarration, Converter={StaticResource TabTextConverter}}"/>
                            </Border>
                            <Label Text="{Binding TNarration}" FontSize="11"
                                   TextColor="{Binding IsTabNarration, Converter={StaticResource TabTextConverter}}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>

                        <!-- Yêu thích -->
                        <StackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="8">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTabFavoriteTapped"/>
                            </StackLayout.GestureRecognizers>
                            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent"
                                    Padding="10"
                                    BackgroundColor="{Binding IsFavoriteActive, Converter={StaticResource TabBgConverter}}">
                                <Label Text="{Binding Poi.Id, Converter={StaticResource FavoriteHeartConverter}}"
                                       FontSize="22" HorizontalOptions="Center"
                                       TextColor="{Binding IsFavoriteActive, Converter={StaticResource TabTextConverter}}"/>
                            </Border>
                            <Label Text="{Binding TFavorite}" FontSize="11"
                                   TextColor="{Binding IsFavoriteActive, Converter={StaticResource TabTextConverter}}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Grid>
                </Border>

                <!-- ── TAB 0: NỘI DUNG ĐỊA ĐIỂM ── -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16" Stroke="#252525" Padding="16"
                        IsVisible="{Binding IsTabLocation}">
                    <StackLayout Spacing="12">
                        <Label Text="{Binding TLocationTitle}" FontSize="13" FontAttributes="Bold" TextColor="#FF6B35"/>
                        <Button Text="{Binding TOpenMap}"
                                Command="{Binding OpenMapCommand}"
                                BackgroundColor="#252525" TextColor="#FF6B35"
                                FontSize="14" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="48"/>
                        <Button Text="{Binding TPlayNarration}"
                                Command="{Binding PlayNarrationCommand}"
                                BackgroundColor="#252525" TextColor="#FF6B35"
                                FontSize="14" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="48"/>
                    </StackLayout>
                </Border>

                <!-- ── TAB 1: NỘI DUNG THUYẾT MINH ── -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16" Stroke="#252525" Padding="16"
                        IsVisible="{Binding IsTabNarration}">
                    <StackLayout Spacing="12">
                        <Label Text="{Binding TNarrationTitle}" FontSize="13" FontAttributes="Bold" TextColor="#FF6B35"/>
                        <!-- Danh sách ngôn ngữ có sẵn -->
                        <Label Text="{Binding TAvailableLangs}" FontSize="11" TextColor="#666666"/>
                        <FlexLayout BindableLayout.ItemsSource="{Binding Scripts}"
                                    Wrap="Wrap" Direction="Row" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="data:LocalAudioScript">
                                    <Grid Margin="4,2" Padding="12,6">
                                        <Border StrokeShape="RoundRectangle 20" Stroke="Transparent">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource MultiLangBgConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                        <Label FontSize="12" FontAttributes="Bold"
                                               Text="{Binding LanguageCode}"
                                               VerticalOptions="Center">
                                            <Label.TextColor>
                                                <MultiBinding Converter="{StaticResource MultiLangTextColorConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Label.TextColor>
                                        </Label>
                                        <Label Text=" ✓" FontSize="10" FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" HorizontalOptions="End"
                                               Margin="0,0,4,0">
                                            <Label.IsVisible>
                                                <MultiBinding Converter="{StaticResource MultiLangBadgeVisibleConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Label.IsVisible>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <!-- Nút phát -->
                        <Button Text="{Binding TPlayNarration}"
                                Command="{Binding PlayNarrationCommand}"
                                BackgroundColor="#252525" TextColor="#FF6B35"
                                FontSize="14" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="44"/>
                    </StackLayout>
                </Border>

                <!-- ── TAB 2: NỘI DUNG YÊU THÍCH ── -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16" Stroke="#252525" Padding="16"
                        IsVisible="{Binding IsTabFavorite}">
                    <StackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="{Binding TFavoriteTitle}" FontSize="15" FontAttributes="Bold" TextColor="#FF6B35"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding Poi.Name}" FontSize="13" TextColor="#AAAAAA"
                               HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                        <Button Text="{Binding TFavoriteAdd}"
                                Command="{Binding ToggleFavoriteCommand}"
                                BackgroundColor="#252525" TextColor="#FF6B35"
                                FontSize="14" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="44"
                                HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- NGÔN NGỮ ĐANG CHỌN + CHỌN NGÔN NGỮ -->
                <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 16" Stroke="#252525" Padding="16">
                    <StackLayout Spacing="10">
                        <StackLayout Spacing="4">
                            <Label Text="{Binding TLangLabel}" FontSize="11" TextColor="#666666"/>
                            <Label Text="{Binding CurrentAudioLangDisplay}" FontSize="18"
                                   FontAttributes="Bold" TextColor="#FF6B35"/>
                            <Label IsVisible="{Binding IsPlayingNarration}"
                                   Text="🔊 Đang phát..." FontSize="12" TextColor="#FF6B35"
                                   FontAttributes="Bold"/>
                        </StackLayout>
                        <Label Text="{Binding TAvailableLangs}" FontSize="11" TextColor="#555555"/>
                        <FlexLayout BindableLayout.ItemsSource="{Binding Scripts}"
                                    Wrap="Wrap" Direction="Row" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="data:LocalAudioScript">
                                    <Grid Margin="4,2" Padding="12,5">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLangChipTapped"/>
                                        </Grid.GestureRecognizers>
                                        <Border StrokeShape="RoundRectangle 20" Stroke="Transparent">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource MultiLangBgConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 20"
                                                StrokeThickness="1.5">
                                            <Border.Stroke>
                                                <MultiBinding Converter="{StaticResource MultiLangStrokeConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Border.Stroke>
                                        </Border>
                                        <Label FontSize="12" FontAttributes="Bold"
                                               Text="{Binding LanguageCode}"
                                               VerticalOptions="Center">
                                            <Label.TextColor>
                                                <MultiBinding Converter="{StaticResource MultiLangTextColorConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Label.TextColor>
                                        </Label>
                                        <Label Text=" ✓" FontSize="10" FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" HorizontalOptions="End"
                                               Margin="0,0,4,0">
                                            <Label.IsVisible>
                                                <MultiBinding Converter="{StaticResource MultiLangBadgeVisibleConverter}">
                                                    <Binding Path="LanguageCode"/>
                                                    <Binding Path="DataContext.CurrentLangCode" Source="{x:Reference RootPage}"/>
                                                </MultiBinding>
                                            </Label.IsVisible>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </StackLayout>
                </Border>

                <BoxView HeightRequest="40" Color="Transparent"/>
            </StackLayout>
        </ScrollView>

        <!-- BOTTOM NAV -->
        <Border Grid.Row="2" Stroke="#1E1E1E" StrokeShape="RoundRectangle 0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111111" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*,*,*" HeightRequest="90">

                <!-- Home -->
                <Grid Grid.Column="0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                    </Grid.GestureRecognizers>
                    <StackLayout Spacing="4" HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="⊞" FontSize="24" TextColor="#444444"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TNavHome}" FontSize="10" TextColor="#444444"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Grid>

                <!-- Map -->
                <Grid Grid.Column="1">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToMapCommand}"/>
                    </Grid.GestureRecognizers>
                    <StackLayout Spacing="4" HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="🗺" FontSize="24" TextColor="#444444"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TNavMap}" FontSize="10" TextColor="#444444"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Grid>

                <!-- Audio FAB -->
                <Grid Grid.Column="2">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAudioCommand}"/>
                    </Grid.GestureRecognizers>
                    <Border StrokeShape="RoundRectangle 30" Stroke="Transparent"
                            WidthRequest="58" HeightRequest="58"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Margin="0,-28,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#FF4500" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="🎵" FontSize="24"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Favorites -->
                <Grid Grid.Column="3">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToFavoritesCommand}"/>
                    </Grid.GestureRecognizers>
                    <StackLayout Spacing="4" HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="❤️" FontSize="22" TextColor="#444444"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TNavFavorites}" FontSize="10" TextColor="#444444"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Grid>

                <!-- Settings -->
                <Grid Grid.Column="4">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                    </Grid.GestureRecognizers>
                    <StackLayout Spacing="4" HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="⚙" FontSize="24" TextColor="#444444"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TNavSettings}" FontSize="10" TextColor="#444444"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentPage>

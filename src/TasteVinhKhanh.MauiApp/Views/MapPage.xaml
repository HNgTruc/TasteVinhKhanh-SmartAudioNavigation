<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TasteVinhKhanh.MauiApp.ViewModels"
             xmlns:data="clr-namespace:TasteVinhKhanh.MauiApp.Data"
             xmlns:conv="clr-namespace:TasteVinhKhanh.MauiApp.Converters"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="TasteVinhKhanh.MauiApp.Views.MapPage"
             x:Name="MapPageRoot"
             x:DataType="vm:MapViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A0A00">

    <ContentPage.Resources>
        <conv:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:ImageUrlConverter x:Key="ImageUrlConverter"/>

        <!-- Card shadow style -->
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#161616"/>
            <Setter Property="Stroke" Value="#252525"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Tag pill style — has audio -->
        <Style x:Key="TagAudio" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A3A1A"/>
            <Setter Property="Stroke" Value="#2A6B2A"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <!-- Tag pill style — no audio -->
        <Style x:Key="TagNone" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A1A1A"/>
            <Setter Property="Stroke" Value="#252525"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <StackLayout Spacing="0">

                <!-- ══ HERO HEADER ══ -->
                <Grid Padding="20,8,20,16">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A0A00" Offset="0"/>
                            <GradientStop Color="#1A0A00" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: title + badge -->
                    <StackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="🍜" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding THeader}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#FFFFFF"/>
                        </StackLayout>

                        <Border BackgroundColor="#FF6B3525"
                                StrokeShape="RoundRectangle 20"
                                Stroke="#FF6B3540"
                                Padding="12,5" HorizontalOptions="Start">
                            <Label Text="{Binding PoiCountLabel}"
                                   FontSize="12" TextColor="#FF6B35"
                                   FontAttributes="Bold"/>
                        </Border>
                    </StackLayout>

                    <!-- Right: emoji decor -->
                    <Label Grid.Column="1" Text="🗺" FontSize="52"
                           Opacity="0.25" VerticalOptions="Center"/>
                </Grid>

                <!-- ══ MAP SECTION ══ -->
                <Border Margin="16,0,16,20" HeightRequest="260"
                        StrokeShape="RoundRectangle 24"
                        Stroke="#252525" Padding="0">
                    <Border.Shadow>
                        <Shadow Radius="16" Offset="0,4" Opacity="0.4"/>
                    </Border.Shadow>
                    <Grid>
                        <maps:Map x:Name="googleMap"
                                  IsShowingUser="True"
                                  MapType="Street"/>

                        <!-- Gradient overlays: top & bottom -->
                        <Rectangle VerticalOptions="Start" HeightRequest="40"
                                    InputTransparent="True">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0D0D0D" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle VerticalOptions="End" HeightRequest="40"
                                    InputTransparent="True">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#1A0A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Map control buttons (top-right) -->
                        <StackLayout VerticalOptions="Start" HorizontalOptions="End"
                                     Padding="0,8" Spacing="8" Margin="0,8,8,0">
                            <Border BackgroundColor="#E00D0D0D"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#333333" Padding="0">
                                <Button Text="⊞" FontSize="15"
                                        BackgroundColor="Transparent"
                                        TextColor="#FF6B35"
                                        WidthRequest="40" HeightRequest="40"
                                        Clicked="FitAllPois_Click"/>
                            </Border>
                            <Border BackgroundColor="#E00D0D0D"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#333333" Padding="0">
                                <Button Text="◎" FontSize="17"
                                        BackgroundColor="Transparent"
                                        TextColor="#FF6B35"
                                        WidthRequest="40" HeightRequest="40"
                                        Clicked="RecenterToUser_Click"/>
                            </Border>
                        </StackLayout>

                        <!-- POI count badge (top-left) -->
                        <Border VerticalOptions="Start" HorizontalOptions="Start"
                                Margin="10,10"
                                BackgroundColor="#E00D0D0D"
                                StrokeShape="RoundRectangle 20"
                                Stroke="#FF6B3550"
                                Padding="10,6">
                            <Label FontSize="12" TextColor="#FF6B35"
                                   FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="📍 "/>
                                        <Span Text="{Binding PoiCountLabel}"/>
                                        <Span Text=" quán"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ POI LIST HEADER ══ -->
                <Grid Padding="20,0,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Grid.Column="0" Spacing="3">
                        <Label Text="{Binding TPoiListTitle}"
                               FontSize="19" FontAttributes="Bold"
                               TextColor="#FFFFFF"/>
                        <Label Text="{Binding TPoiListSub}"
                               FontSize="12" TextColor="#666666"/>
                    </StackLayout>
                    <Border Grid.Column="1" VerticalOptions="Center"
                            BackgroundColor="#FF6B3515"
                            StrokeShape="RoundRectangle 14"
                            Stroke="#FF6B3530"
                            Padding="12,6">
                        <Label Text="{Binding PoiCountLabel}" FontSize="13"
                               TextColor="#FF6B35" FontAttributes="Bold"/>
                    </Border>
                </Grid>

                <!-- ══ POI CARDS ══ -->
                <CollectionView ItemsSource="{Binding Pois}"
                                SelectionMode="None"
                                Margin="0,0,0,28">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:LocalPoi">
                            <Grid Padding="16,4">
                                <Border BackgroundColor="#161616"
                                        StrokeShape="RoundRectangle 20"
                                        Stroke="#252525"
                                        Padding="0">
                                    <Border.Shadow>
                                        <Shadow Radius="8" Offset="0,3"
                                                Opacity="0.25"/>
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference MapPageRoot}, Path=BindingContext.GoToDetailCommand}"
                                            CommandParameter="{Binding Id}"/>
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto">

                                        <!-- Row 1: Icon + Info + Like -->
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="Auto,*,Auto"
                                              Padding="14,12">

                                            <!-- Food icon: logo nếu có, fallback 🍜 -->
                                            <Grid Grid.Column="0"
                                                  WidthRequest="58"
                                                  HeightRequest="58">
                                                <Border StrokeShape="RoundRectangle 16"
                                                        Stroke="Transparent"
                                                        WidthRequest="58"
                                                        HeightRequest="58">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0"
                                                                             EndPoint="1,1">
                                                            <GradientStop Color="#2A1200" Offset="0"/>
                                                            <GradientStop Color="#1A0A00" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <!-- Fallback emoji -->
                                                    <Label Text="🍜" FontSize="28"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding LogoUrl, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Inverse}"/>
                                                </Border>
                                                <!-- Logo quán -->
                                                <Image Source="{Binding LogoUrl, Converter={StaticResource ImageUrlConverter}}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="58"
                                                       HeightRequest="58"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding LogoUrl, Converter={StaticResource NullToBoolConverter}}">
                                                    <Image.Clip>
                                                        <RoundRectangleGeometry CornerRadius="16" Rect="0,0,58,58"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>

                                            <!-- Name + address -->
                                            <StackLayout Grid.Column="1" Spacing="5"
                                                         Margin="12,0"
                                                         VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFFFFF"
                                                       MaxLines="1"/>
                                                <Label Text="{Binding ShortDescription}"
                                                       FontSize="12"
                                                       TextColor="#777777"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"/>
                                            </StackLayout>

                                            <!-- Like btn -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="#1A1A1A"
                                                    StrokeShape="RoundRectangle 14"
                                                    Stroke="#2A2A2A"
                                                    Padding="0"
                                                    WidthRequest="44">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference MapPageRoot}, Path=BindingContext.ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding Id}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Id, Converter={StaticResource FavoriteIconConverter}}"
                                                       FontSize="17"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Tags -->
                                        <Grid Grid.Row="1" Padding="14,0,14,14">
                                            <HorizontalStackLayout Spacing="8">

                                                <!-- Distance -->
                                                <Border BackgroundColor="#1E1E1E"
                                                        StrokeShape="RoundRectangle 10"
                                                        Stroke="#2E2E2E"
                                                        Padding="10,5">
                                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                                        <Label Text="📍" FontSize="11"
                                                               VerticalOptions="Center"/>
                                                        <Label FontSize="12" TextColor="#AAAAAA">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding TriggerRadiusMeters}"/>
                                                                    <Span Text="m"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </StackLayout>
                                                </Border>

                                                <!-- Audio badge (dynamic style) -->
                                                <Border StrokeShape="RoundRectangle 10"
                                                        Padding="10,5"
                                                        BackgroundColor="#1A3A1A"
                                                        Stroke="#2A6B2A">
                                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                                        <Label Text="🎧" FontSize="11"
                                                               VerticalOptions="Center"/>
                                                        <Label Text="{Binding Source={x:Reference MapPageRoot}, Path=BindingContext.THasNarration}"
                                                               FontSize="12"
                                                               TextColor="#66CC66"/>
                                                    </StackLayout>
                                                </Border>

                                                <!-- Chevron -->
                                                <Label Text="›" FontSize="18"
                                                       TextColor="#333333"
                                                       VerticalOptions="Center"
                                                       Margin="6,0,0,0"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Row 3: Smart recommendation strip -->
                                        <Border Grid.Row="2"
                                                BackgroundColor="#FF6B3518"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 0,0,20,20"
                                                Padding="14,7">
                                            <Label FontSize="11" TextColor="#FF8C55">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="✨ "/>
                                                        <Span Text="Smart Recommendation"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Border>

                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center"
                                     Padding="40,60" Spacing="16">
                            <Label Text="📭" FontSize="52"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding TLoading}"
                                   FontSize="15" TextColor="#555555"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding TLoadingHint}"
                                   FontSize="12" TextColor="#333333"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <BoxView HeightRequest="90" Color="Transparent"/>

            </StackLayout>
        </ScrollView>

        <!-- ══ BOTTOM NAV ══ -->
        <Border Grid.Row="1" Stroke="#1E1E1E" StrokeShape="RoundRectangle 0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#111111" Offset="0"/>
                    <GradientStop Color="#1A0A00" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,*,*,*" Padding="0,10,0,24">

                <!-- Home -->
                <StackLayout Grid.Column="0" Spacing="4"
                             HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="⊞" FontSize="24" TextColor="#444444"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding TNavHome}" FontSize="10" TextColor="#444444"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <!-- Map — active -->
                <StackLayout Grid.Column="1" Spacing="4"
                             HorizontalOptions="Center">
                    <Border BackgroundColor="#FF6B3520"
                            StrokeShape="RoundRectangle 10"
                            Stroke="Transparent" Padding="10,6"
                            HorizontalOptions="Center">
                        <Label Text="🗺" FontSize="20" TextColor="#FF6B35"
                               HorizontalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding TNavMap}" FontSize="10" TextColor="#FF6B35"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <!-- Audio -->
                <Grid Grid.Column="2" HorizontalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAudioCommand}"/>
                    </Grid.GestureRecognizers>
                    <Border StrokeShape="RoundRectangle 30"
                            Stroke="Transparent"
                            WidthRequest="58" HeightRequest="58"
                            HorizontalOptions="Center"
                            Margin="0,-28,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF6B35" Offset="0"/>
                                <GradientStop Color="#FF4500" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="🎵" FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Settings -->
                <StackLayout Grid.Column="3" Spacing="4"
                             HorizontalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                    </StackLayout.GestureRecognizers>
                    <Label Text="⚙" FontSize="24" TextColor="#444444"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding TNavSettings}" FontSize="10" TextColor="#444444"
                           HorizontalOptions="Center"/>
                </StackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
